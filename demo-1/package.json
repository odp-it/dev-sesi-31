{
  "name": "tabungan-umkm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API Tabungan UMKM (data simulasi) dengan Express 5 dan node-oracledb",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:reset": "node --env-file=.env scripts/db-reset.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "oracledb": "26.0.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
